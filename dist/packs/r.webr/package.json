{
  "name": "runtimecode-pack-r-webr",
  "displayName": "R (WebR)",
  "description": "R compiled to wasm via Emscripten, with its own repository of precompiled packages. Built from 0.6.0.",
  "version": "1.0.0",
  "publisher": "runtimecode",
  "license": "GPL-3.0",
  "engines": {
    "vscode": "^1.137.0"
  },
  "categories": [
    "Programming Languages",
    "Other"
  ],
  "browser": "./extension.js",
  "activationEvents": [],
  "capabilities": {
    "virtualWorkspaces": true,
    "untrustedWorkspaces": {
      "supported": true
    }
  },
  "contributes": {
    "runtimecode.runtimes": [
      {
        "id": "r.webr",
        "displayName": "R (WebR)",
        "languages": [
          "r"
        ],
        "tier": "faithful",
        "engine": "webr",
        "languageVersion": "4.4",
        "site": "worker",
        "worker": "./session.js",
        "assets": "./assets/",
        "pack": "r.webr",
        "installBytes": 18915392,
        "license": "GPL-3.0",
        "homepage": "https://docs.r-wasm.org/webr/latest/",
        "summary": "R compiled to wasm via Emscripten, with its own repository of precompiled packages.",
        "requires": {
          "crossOriginIsolated": false
        },
        "capabilities": {
          "stdin": "buffered",
          "threads": false,
          "packages": "webr-packages",
          "graphics": "none",
          "debug": false,
          "fs": "mount"
        }
      }
    ]
  }
}
