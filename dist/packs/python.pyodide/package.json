{
  "name": "runtimecode-pack-python-pyodide",
  "displayName": "Python (Pyodide)",
  "description": "The whole of CPython, plus micropip and prebuilt scientific wheels. Built from 0.28.3.",
  "version": "1.0.0",
  "publisher": "runtimecode",
  "license": "MPL-2.0 AND Python-2.0",
  "engines": {
    "vscode": "^1.137.0"
  },
  "categories": [
    "Programming Languages",
    "Other"
  ],
  "browser": "./extension.js",
  "activationEvents": [],
  "capabilities": {
    "virtualWorkspaces": true,
    "untrustedWorkspaces": {
      "supported": true
    }
  },
  "contributes": {
    "runtimecode.runtimes": [
      {
        "id": "python.pyodide",
        "displayName": "Python (Pyodide)",
        "languages": [
          "python"
        ],
        "tier": "quick",
        "engine": "pyodide",
        "languageVersion": "3.12",
        "site": "worker",
        "worker": "./session.js",
        "assets": "./assets/",
        "pack": "python.pyodide",
        "installBytes": 12262929,
        "license": "MPL-2.0 AND Python-2.0",
        "homepage": "https://pyodide.org/en/stable/usage/downloading-and-deploying.html",
        "summary": "The whole of CPython, plus micropip and prebuilt scientific wheels.",
        "requires": {
          "crossOriginIsolated": false
        },
        "capabilities": {
          "stdin": "buffered",
          "threads": false,
          "packages": "micropip",
          "graphics": "none",
          "debug": false,
          "fs": "mount"
        },
        "isolatedCapabilities": {
          "stdin": "blocking"
        }
      }
    ]
  }
}
