+	/**
+	 * Upstream throws here, which makes the "Open Folder" button in the empty
+	 * workbench dead in every browser. The machinery to do it already exists —
+	 * showOpenDialog() picks a directory via showDirectoryPicker() and registers
+	 * it with the HTMLFileSystemProvider — so use that, and fall back to the
+	 * RuntimeFS options where the File System Access API is unavailable.
+	 */
+	private async pickFolderAndOpenWeb(options: IPickAndOpenOptions): Promise<void> {
+		const activeWindow = getActiveWindow();
+		if (!WebFileSystemAccess.supported(activeWindow)) {
+			return this.showUnsupportedBrowserWarning('open');
+		}
+
+		let uri: URI | undefined;
+		try {
+			const handle = await activeWindow.showDirectoryPicker({
+				...{ startIn: Iterable.first(this.fileSystemProvider.directories) ?? 'documents' }
+			});
+			uri = await this.fileSystemProvider.registerDirectoryHandle(handle);
+		} catch (error) {
+			return; // `showDirectoryPicker` throws when the user cancels
+		}
+
+		if (uri) {
+			return this.hostService.openWindow([{ folderUri: uri }], {
+				forceNewWindow: options.forceNewWindow,
+				remoteAuthority: options.remoteAuthority
+			});
+		}
 	}
 
