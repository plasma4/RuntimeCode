{
  "name": "runtimecode-pack-lua-wasmoon",
  "displayName": "Lua (wasmoon)",
  "description": "The official Lua VM compiled to wasm, real performance and cheap to embed. Built from 1.16.0.",
  "version": "1.0.0",
  "publisher": "runtimecode",
  "license": "MIT",
  "engines": {
    "vscode": "^1.137.0"
  },
  "categories": [
    "Programming Languages",
    "Other"
  ],
  "browser": "./extension.js",
  "activationEvents": [],
  "capabilities": {
    "virtualWorkspaces": true,
    "untrustedWorkspaces": {
      "supported": true
    }
  },
  "contributes": {
    "runtimecode.runtimes": [
      {
        "id": "lua.wasmoon",
        "displayName": "Lua (wasmoon)",
        "languages": [
          "lua"
        ],
        "tier": "quick",
        "engine": "wasmoon",
        "languageVersion": "5.4",
        "site": "worker",
        "worker": "./session.js",
        "assets": "./assets/",
        "pack": "lua.wasmoon",
        "installBytes": 423233,
        "license": "MIT",
        "homepage": "https://github.com/ceifa/wasmoon",
        "summary": "The official Lua VM compiled to wasm, real performance and cheap to embed.",
        "requires": {
          "crossOriginIsolated": false
        },
        "capabilities": {
          "stdin": "buffered",
          "threads": false,
          "packages": "none",
          "graphics": "none",
          "debug": false,
          "fs": "mount"
        },
        "isolatedCapabilities": {
          "stdin": "blocking"
        }
      }
    ]
  }
}
