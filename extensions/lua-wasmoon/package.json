{
	"name": "lua-wasmoon",
	"displayName": "Lua (wasmoon)",
	"description": "The official Lua VM compiled to WebAssembly, with a JS bridge. Runs .lua files in the runtime host.",
	"version": "0.0.1",
	"publisher": "runtimecode",
	"license": "MIT",
	"engines": {
		"vscode": "^1.137.0"
	},
	"categories": [
		"Other"
	],
	"browser": "./extension.js",
	"capabilities": {
		"virtualWorkspaces": true,
		"untrustedWorkspaces": {
			"supported": true
		}
	},
	"contributes": {
		"runtimecode.runtimes": [
			{
				"id": "lua.wasmoon",
				"displayName": "Lua (wasmoon)",
				"description": "The official Lua VM compiled to WebAssembly, with a JS bridge.",
				"languages": [
					"lua"
				],
				"tier": "quick",
				"engine": "wasmoon 1.16.0",
				"languageVersion": "5.4",
				"site": "host",
				"assets": "./assets/",
				"installBytes": 423233,
				"requires": {
					"crossOriginIsolated": false
				},
				"capabilities": {
					"stdin": "none",
					"threads": false,
					"packages": "none",
					"graphics": "none",
					"debug": false,
					"fs": "none"
				}
			}
		]
	}
}
