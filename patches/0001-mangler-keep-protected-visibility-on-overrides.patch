Keep `protected` on overridden members so the mangler accepts the tree.

ChangesetReviewActionViewItem overrides two protected members of
CheckboxActionViewItem without repeating the keyword, which widens them to
public. The build mangler rejects that outright ("Protected fields have been
made PUBLIC") and no RuntimeCode setting can work around it.

Upstream defect, present on main and on every tag we have built. Drop this
patch once upstream fixes it.
diff --git a/src/vs/sessions/contrib/changes/browser/sessionChangesEditor.ts b/src/vs/sessions/contrib/changes/browser/sessionChangesEditor.ts
index ce4196da125..e56d7c7f65c 100644
--- a/src/vs/sessions/contrib/changes/browser/sessionChangesEditor.ts
+++ b/src/vs/sessions/contrib/changes/browser/sessionChangesEditor.ts
@@ -498,7 +498,7 @@ class ChangesetReviewActionViewItem extends CheckboxActionViewItem {
 		container.classList.add('changeset-review-action', 'multi-diff-action-always-visible');
 	}
 
-	override updateChecked(): void {
+	protected override updateChecked(): void {
 		super.updateChecked();
 
 		this.element?.classList.toggle('checked', !!this.action.checked);
@@ -506,7 +506,7 @@ class ChangesetReviewActionViewItem extends CheckboxActionViewItem {
 		this.updateTooltip();
 	}
 
-	override getTooltip(): string {
+	protected override getTooltip(): string {
 		return this.action.checked
 			? localize('changeset.viewed.tooltip', "Mark as Not Viewed")
 			: localize('changeset.notViewed.tooltip', "Mark as Viewed");
