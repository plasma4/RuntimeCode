+/* RuntimeCode: RuntimeFS entries carry their own hue in both the Start list and
+   Recent, so a folder's origin reads at a glance without a path beside it. The
+   `button.` qualifier is what outspecifies the generic button.button-link rules
+   above; dropping it makes these silently lose on :hover. */
+.monaco-workbench .part.editor > .content .gettingStartedContainer button.button-link.runtimefs,
+.monaco-workbench .part.editor > .content .gettingStartedContainer button.button-link.runtimefs:hover,
+.monaco-workbench .part.editor > .content .gettingStartedContainer button.button-link.runtimefs:active,
+.monaco-workbench .part.editor > .content .gettingStartedContainer button.button-link.runtimefs .codicon,
+.monaco-workbench .part.editor > .content .gettingStartedContainer button.button-link.runtimefs:hover .codicon,
+.monaco-workbench .part.editor > .content .gettingStartedContainer button.button-link.runtimefs:active .codicon {
+	color: var(--vscode-welcomePage-runtimeFSForeground);
+}
+
 .monaco-workbench .part.editor > .content .gettingStartedContainer .gettingStartedSlideCategories .progress-bar-inner {
 	background-color: var(--vscode-welcomePage-progress-foreground);
 }
